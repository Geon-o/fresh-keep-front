{
  "expo": {
    "name": "냉장고집사",
    "slug": "fresh-keep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freshkeep",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jgo_geon.freshkeep",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mustache_static.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#BBDEFB"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "식재료 등록 시 제품 바코드를 스캔하려면 카메라 접근 권한이 필요합니다."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Expiring",
              "label": "유통기한 임박",
              "minWidth": "180dp",
              "minHeight": "48dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview-expiring.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ExpiringSummary",
              "label": "유통기한 요약",
              "minWidth": "180dp",
              "minHeight": "48dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview-summary.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-seoul/naver-login"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ba3246c-7338-4b2b-8119-1a43bc78b77c"
      }
    }
  }
}
