# 복사해서 `.env` 를 만든 뒤 값을 채우세요. (.env 는 커밋 금지 — .gitignore 처리됨)
# Expo 는 EXPO_PUBLIC_ 접두어가 붙은 값만 앱에 주입합니다. 이 값들은 앱 번들에 포함(=추출 가능)되니
# OAuth public client ID 는 넣어도 되지만 진짜 서버 시크릿은 넣지 마세요.
# .env 를 바꾸면 재빌드(prebuild + run:android)해야 값이 반영됩니다.

# API Base URL Configuration for Local/Production Backend
# 1. iOS Simulator: http://localhost:8086
# 2. Android Emulator: http://10.0.2.2:8086 (points to host machine's localhost)
# 3. Real Device / Expo Go: http://<YOUR_PC_IP>:8086 (e.g. http://192.168.0.10:8086)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8086

# 구글 — 둘 다 .apps.googleusercontent.com 로 끝남 (Google Cloud Console > 사용자 인증 정보)
# WEB: "웹 애플리케이션" 클라이언트 ID (idToken audience, 백엔드 GOOGLE_WEB_CLIENT_ID 와 동일)
# ANDROID: "Android" 클라이언트 ID (패키지명 + SHA-1 등록 필요, dev/release 각각)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<xxxxx.apps.googleusercontent.com>
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<xxxxx.apps.googleusercontent.com>

# 네이버 (Naver Developers > 내 애플리케이션 > 애플리케이션 정보)
EXPO_PUBLIC_NAVER_CLIENT_ID=<네이버 Client ID>
EXPO_PUBLIC_NAVER_CLIENT_SECRET=<네이버 Client Secret>
EXPO_PUBLIC_NAVER_URL_SCHEME=freshkeep

# (선택 · iOS 출시할 때만) 구글 iOS URL 스킴. 미설정 시 app.config.js 가 플레이스홀더 사용.
#   형식: com.googleusercontent.apps.<iOS 클라이언트 ID 앞부분>
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxx
